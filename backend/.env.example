# ==============================================================================
# Ente Naadu (എന്റെ നാട്) - Production Environment Variables Template
# ==============================================================================
# IMPORTANT:
# 1. Copy this file to .env on your deployment server: `cp .env.example .env`
# 2. Never commit your real .env file or production secrets to Git!
# 3. Ensure DEBUG=False in any production environment!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SECURITY
# ------------------------------------------------------------------------------
# Generate a cryptographically secure key: python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=replace-with-a-very-long-random-string-at-least-50-characters

# ALWAYS False in production! Never set to True on a live public domain.
DEBUG=False

# Comma-separated list of fully qualified domains and IP addresses handling requests
# Example: entenaadu.kerala.gov.in,api.entenaadu.in,your-subdomain.onrender.com
ALLOWED_HOSTS=entenaadu.kerala.gov.in,api.entenaadu.in,localhost,127.0.0.1,.onrender.com

# Set to True to enforce HTTPS redirect. Set to False if an upstream reverse proxy
# (Nginx, Cloudflare, AWS ALB) terminates SSL before forwarding to Gunicorn.
SECURE_SSL_REDIRECT=True

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Supported protocols:
#   A. PostgreSQL (e.g. Neon Serverless Postgres, AWS RDS Postgres, Self-Hosted):
#      DATABASE_URL=postgresql://user:password@ep-name.ap-south-1.aws.neon.tech:5432/entenaadudb?sslmode=require
#   B. MySQL / MariaDB (e.g. Self-hosted Ubuntu MySQL, AWS RDS MySQL):
#      DATABASE_URL=mysql://entenaadu_user:StrongPassword123@127.0.0.1:3306/entenaadu_db
#   C. SQLite (Local dev/testing only):
#      DATABASE_URL=sqlite:///db.sqlite3
DATABASE_URL=mysql://entenaadu_user:StrongPassword123@127.0.0.1:3306/entenaadu_db

# Persistent database connection pooling age in seconds (600s = 10 mins)
DB_CONN_MAX_AGE=600

# Optional: Path to MySQL SSL Certificate Authority (CA) if using SSL-enforced MySQL
# MYSQL_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# ------------------------------------------------------------------------------
# 3. CORS & CSRF TRUSTED ORIGINS
# ------------------------------------------------------------------------------
# Domains allowed to make cross-origin AJAX / REST requests
CORS_ALLOWED_ORIGINS=https://entenaadu.kerala.gov.in,https://admin.entenaadu.in

# Domains trusted for POST/PUT/DELETE forms and CSRF cookie validation
CSRF_TRUSTED_ORIGINS=https://entenaadu.kerala.gov.in,https://api.entenaadu.in,https://*.onrender.com

# ------------------------------------------------------------------------------
# 4. STATIC & MEDIA FILE STORAGE (AWS S3 / CLOUDFLARE R2 / MINIO)
# ------------------------------------------------------------------------------
# Set USE_S3=True to enable persistent cloud object storage for citizen uploads
# (Shop photos, civic complaint images, item pictures, etc.)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=entenaadu-media
AWS_S3_REGION_NAME=ap-south-1

# Optional: S3 endpoint URL for Cloudflare R2 or MinIO (e.g. https://<account_id>.r2.cloudflarestorage.com)
AWS_S3_ENDPOINT_URL=
# Optional: CDN / custom domain for media assets (e.g. https://media.entenaadu.in)
AWS_S3_CUSTOM_DOMAIN=

# ------------------------------------------------------------------------------
# 5. ERROR MONITORING & PERFORMANCE (SENTRY)
# ------------------------------------------------------------------------------
# Get your free DSN from https://sentry.io/ (₹0 tier includes 5,000 events/month)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 6. LOGGING
# ------------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 7. AI ASSISTANT (PANCHAYAT CITIZEN BOT)
# ------------------------------------------------------------------------------
# Optional: Google Gemini 1.5 Flash Free API key (https://aistudio.google.com/)
# If left empty, Ente Naadu uses the built-in intelligent local search responder (₹0 guaranteed)
GEMINI_API_KEY=


